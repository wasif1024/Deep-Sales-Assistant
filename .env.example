# Copy to .env and fill in. Never commit .env.

# Required: the chat models (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Required: tracing and sandboxes (https://smith.langchain.com).
# Your LangSmith organization must have the Sandboxes feature enabled.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=deep-sales-assistant

# Optional: enables the web-research subagent (https://tavily.com)
TAVILY_API_KEY=
